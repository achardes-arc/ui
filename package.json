{
  "name": "@arcadran/ui",
  "version": "0.1.0",
  "description": "Vue components for the Arcadran design system",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@arcadran/design-system": "2.2.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@arcadran/design-system": "2.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.19.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  },
  "scripts": {
    "dev": "vite --config gallery/vite.config.ts --host 127.0.0.1 --port 3011",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "build:gallery": "vite build --config gallery/vite.config.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check:styles": "node scripts/check-styles.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check": "pnpm typecheck && pnpm check:styles && pnpm test && pnpm build && pnpm check:package && pnpm build:gallery",
    "prepack": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/achardes-arc/ui.git"
  }
}
